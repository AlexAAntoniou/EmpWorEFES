                <ab>
                    <lb n="1"/><persName type="divine" key="belenusAugustus"><name>Beleno</name></persName>
                    <lb n="2"/><name><expan><abbr>Aug</abbr><ex>usto</ex></expan></name> <expan><abbr>sac</abbr><ex>rum</ex></expan>
                    <lb n="3"/><persName type="attested"><name><expan><abbr>L</abbr><ex>ucius</ex></expan> Cornelius
                    <lb n="4"/><persName type="attested"><name><expan><abbr>L</abbr><ex>uci</ex></expan></name> <expan><abbr>fil</abbr><ex>ius</ex></expan></persName> <expan><abbr>Vell</abbr><ex>ina</ex></expan>
                    <lb n="5"/>Secundinus</name></persName>
                    <lb n="6"/><placeName>Aquileia</placeName>
                    <lb n="7"/><expan><abbr>evoc</abbr><ex>atus</ex></expan> <expan><abbr>Aug</abbr><ex>usti</ex></expan> nostri
