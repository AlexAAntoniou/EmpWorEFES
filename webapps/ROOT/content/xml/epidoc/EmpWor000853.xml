            <div type="apparatus">
                <listApp>
                    <app><note>Text from EDR; with restoration of Fishwick 1991, 612</note></app>
                    <app loc="3"><note>EDR provides restoration of c(reato) d(ecreto) d(ecurionum) in line 3.</note></app>
