                    <lb n="8"/>flamini <persName type="divine" key="divusAugustus"><name>divi</name> <name><expan><abbr>Aug</abbr><ex>usti</ex></expan></name></persName> et <persName type="divine" key="roma">Romai</persName>
                    <lb n="9"/><persName type="attested"><name><expan><abbr>C</abbr><ex>aius</ex></expan></name> <name>Ligurius</name> <persName type="patronym"><name><expan><abbr>L</abbr><ex>uci</ex></expan></name> <expan><abbr>f</abbr><ex>ilius</ex></expan></persName> <expan><abbr>Vol</abbr><ex>tinia</ex></expan> <name>Asper</name></persName>
                    <lb n="10"/><expan><abbr><am><g type="centuria"/></am></abbr><ex>centurio</ex></expan> <expan><abbr>coh</abbr><ex>ortis</ex></expan> <num value="1">I</num> <expan><abbr>c</abbr><ex>ivium</ex></expan> <expan><abbr>R</abbr><ex>omanorum</ex></expan> <expan><abbr>ingenuor</abbr><ex>um</ex></expan>
