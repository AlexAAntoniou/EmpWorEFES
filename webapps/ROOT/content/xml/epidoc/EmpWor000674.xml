                    <lb n="4"/><expan><abbr>procur</abbr><ex>atori</ex></expan> <expan><abbr>Augustor</abbr><ex>um</ex></expan> et
                    <lb n="5"/>pro <expan><abbr>leg</abbr><ex>ato</ex></expan> provinciai
                    <lb n="6"/><placeName><name>Raitiai</name></placeName> et <placeName><name><expan><abbr>Vindelic</abbr><ex>iae</ex></expan></name></placeName>
