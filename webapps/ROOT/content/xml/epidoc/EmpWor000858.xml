                            </supportDesc>
                            <layoutDesc>
                                <layout><p>The text is centred on the stone, taking up most of the assigned space.</p>
                                    <rs ana="#execution.chiselled" ref="http://www.eagle-network.eu/voc/writing/lod/1">chiselled</rs>
                                    <damage/>
